# Copy to .env.render locally, or set these privately in Render. No real secrets here.
SAFE_NAVI_CLOUD_MODE=true
SAFE_NAVI_DATABASE_URL=postgresql://postgres.PROJECT:PERCENT_ENCODED_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SAFE_NAVI_DATABASE_SCHEMA=safenavi
SAFE_NAVI_EVIDENCE_BACKEND=supabase
SAFE_NAVI_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the server-only legacy service_role JWT, never the anon/publishable key.
SAFE_NAVI_SUPABASE_SERVICE_KEY=
SAFE_NAVI_SUPABASE_BUCKET=safenavi-evidence
SAFE_NAVI_NEWS_SCHEDULER=external
# Copy Render's generated value into Supabase Vault, not into the cron SQL file.
SAFE_NAVI_SCHEDULER_KEY=
SAFE_NAVI_NEWS_FEEDS=https://indianexpress.com/section/cities/mumbai/feed/,https://www.hindustantimes.com/feeds/rss/cities/mumbai-news/rssfeed.xml
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SAFE_NAVI_CORS_ORIGINS=
