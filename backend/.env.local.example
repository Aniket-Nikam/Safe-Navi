# Copy this file to .env.local. The real file is ignored by Git.
GROQ_API_KEY=replace-with-your-server-side-key
GROQ_MODEL=openai/gpt-oss-20b

# Comma-separated HTTPS RSS/Atom feeds. Every item remains review-only.
SAFE_NAVI_NEWS_FEEDS=https://indianexpress.com/section/cities/mumbai/feed/,https://indianexpress.com/section/cities/navi-mumbai/feed/,https://www.hindustantimes.com/feeds/rss/cities/mumbai-news/rssfeed.xml
