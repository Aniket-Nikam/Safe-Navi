# Public DNS hostname pointing to your persistent VM (not an IP or URL).
SAFE_NAVI_HOST=replace-with-your-hostname.example
# Set a newly rotated key privately. Never commit .env.production.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Comma-separated HTTPS RSS/Atom feeds. Admin selects 12/24-hour refresh.
SAFE_NAVI_NEWS_FEEDS=
SAFE_NAVI_CORS_ORIGINS=https://replace-with-your-hostname.example
