<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:usesCleartextTraffic="false"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_icon"
        android:roundIcon="@drawable/ic_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XavierProject"
        tools:targetApi="31">

        <!-- Splash Activity (App Entry Point) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.XavierProject.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Type Selection Activity -->
        <activity
            android:name=".LoginTypeActivity"
            android:exported="false"
            android:theme="@style/Theme.XavierProject" />

        <!-- Login Activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.XavierProject" />

        <!-- SignUp Activity -->
        <activity
            android:name=".SignUpActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.XavierProject" />

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.XavierProject" />
            
        <activity
            android:name=".AdminMainActivity"
            android:exported="false"
            android:theme="@style/Theme.XavierProject" />
            
        <activity
            android:name=".GovMainActivity"
            android:exported="false"
            android:theme="@style/Theme.XavierProject" />

        <activity
            android:name=".GovernmentSafetyDashboardActivity"
            android:exported="false"
            android:theme="@style/Theme.XavierProject" />
            
        <activity
            android:name=".ManageUsersActivity"
            android:exported="false"
            android:theme="@style/Theme.XavierProject" />

        <!-- Maps Activity -->
        <activity
            android:name=".MapsActivity"
            android:label="Maps"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.XavierProject" />

        <!-- Complaints Activity -->
        <activity
            android:name=".ComplaintsActivity"
            android:label="Complaints"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.XavierProject" />

        <activity android:name=".DiscussionActivity" android:exported="false" />
        <activity android:name=".CommentsActivity" android:exported="false" />
        <activity android:name=".chatMainActivity" android:exported="false" />


        <!-- Settings Activity -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.XavierProject" />
        <activity android:name=".ComplaintDetailActivity" />
    </application>

</manifest>
