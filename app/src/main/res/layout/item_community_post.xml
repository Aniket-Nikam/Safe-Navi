<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/divider"
    app:strokeWidth="1dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/communityPostAuthor" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:id="@+id/communityPostCategory" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_label" android:letterSpacing="0.08" android:textColor="@color/primary" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/communityPostContent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="3dp" android:textColor="@color/text_primary" android:textSize="16sp" />
        <ImageView android:id="@+id/communityPostImage" android:layout_width="match_parent" android:layout_height="210dp" android:layout_marginTop="12dp" android:adjustViewBounds="true" android:contentDescription="Community photograph" android:scaleType="centerCrop" android:visibility="gone" />
        <TextView android:id="@+id/communityPostTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textColor="@color/text_secondary" android:textSize="11sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/communityVoteButton" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Helpful · 0" android:textAllCaps="false" android:textColor="@color/primary" app:icon="@drawable/ic_upvote" app:iconTint="@color/primary" />
            <com.google.android.material.button.MaterialButton android:id="@+id/communityCommentsButton" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="Discuss · 0" android:textAllCaps="false" android:textColor="@color/text_secondary" app:icon="@drawable/ic_comment" app:iconTint="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
