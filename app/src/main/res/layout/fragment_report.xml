<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:letterSpacing="0.12" android:text="COMMUNITY SIGNAL" android:textColor="@color/primary" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Report what you see" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Your report enters an official review queue. It affects public routes only after verification." android:textColor="@color/text_secondary" android:textSize="13sp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardBackgroundColor="@color/surface" app:cardCornerRadius="22dp" app:cardElevation="1dp" app:strokeColor="@color/divider" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Issue title" app:boxBackgroundMode="outline" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/editTextTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLength="140" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Category" app:boxBackgroundMode="outline" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp" app:endIconMode="dropdown_menu">
                    <AutoCompleteTextView android:id="@+id/autoCompleteCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Describe the issue and immediate risk" app:boxBackgroundMode="outline" app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/editTextDescription" android:layout_width="match_parent" android:layout_height="120dp" android:gravity="top" android:inputType="textMultiLine" android:maxLength="4000" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonAddEvidence" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp" android:text="Add photos or short video" android:textAllCaps="false" app:cornerRadius="14dp" />
                <TextView android:id="@+id/textEvidenceStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Optional · up to 5 files · 15 MB each" android:textColor="@color/text_secondary" android:textSize="11sp" />
                <CheckBox android:id="@+id/checkAnonymous" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Hide my identity from operational report views" android:textColor="@color/text_primary" android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pin the exact location" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tap the map or use your position" android:textColor="@color/text_secondary" android:textSize="12sp" />
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/useCurrentLocationButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="44dp" android:text="My location" android:textAllCaps="false" app:cornerRadius="13dp" app:icon="@drawable/ic_location" />
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="260dp" android:layout_marginTop="12dp" app:cardCornerRadius="20dp" app:cardElevation="1dp">
            <org.maplibre.android.maps.MapView android:id="@+id/mapFragment" android:layout_width="match_parent" android:layout_height="match_parent" />
        </com.google.android.material.card.MaterialCardView>
        <TextView android:id="@+id/textViewLocationInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/bg_label" android:padding="12dp" android:text="Select a precise location on the map" android:textColor="@color/text_secondary" android:textSize="12sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonViewHistory" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginEnd="6dp" android:layout_weight="1" android:text="My reports" android:textAllCaps="false" app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonSubmitReport" android:layout_width="0dp" android:layout_height="54dp" android:layout_marginStart="6dp" android:layout_weight="1" android:text="Send for review" android:textAllCaps="false" android:textStyle="bold" app:backgroundTint="@color/primary" app:cornerRadius="16dp" />
        </LinearLayout>
        <ProgressBar android:id="@+id/progressBar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="14dp" android:visibility="gone" />
    </LinearLayout>
</ScrollView>
