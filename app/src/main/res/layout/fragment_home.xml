<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAFE-NAVI · LIVE SAFETY INTELLIGENCE"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
        <TextView
            android:id="@+id/welcomeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Good evening, Citizen"
            android:textColor="@color/text_primary"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Safety context for every route, without hiding the trade-offs."
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="@color/primary_dark"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOCATION SAFETY"
                            android:textColor="@color/accent"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />
                        <TextView
                            android:id="@+id/riskLevelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Moderate risk · High confidence"
                            android:textColor="@color/on_dark_surface"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:background="@drawable/circle_green_background"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/safetyScoreText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="72"
                            android:textColor="@color/primary_dark"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SCORE"
                            android:textColor="@color/on_accent"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/safetyExplanationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="A verified hazard nearby contributes to this score."
                    android:textColor="@color/dark_surface_secondary"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openSafetyMapButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="Open safety map"
                    android:textAllCaps="false"
                    android:textColor="@color/primary_dark"
                    android:textStyle="bold"
                    app:backgroundTint="@color/accent"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_map"
                    app:iconTint="@color/primary_dark" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Take action"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportDangerButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Report danger"
                android:textAllCaps="false"
                android:textColor="@color/danger_text"
                app:cornerRadius="16dp"
                app:strokeColor="@color/danger_border" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/openCommunityButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Local community"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                app:cornerRadius="16dp"
                app:strokeColor="@color/positive_border" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/openAssistantButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Ask the Safe-Navi assistant"
            android:textAllCaps="false"
            android:textColor="@color/on_dark_surface"
            app:backgroundTint="@color/secondary_button"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_chatbot"
            app:iconTint="@color/on_dark_surface" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/scoreDisclosureButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="How Safe-Navi calculates this score"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary" />
    </LinearLayout>
</ScrollView>
