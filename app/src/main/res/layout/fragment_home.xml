<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7F5"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SAFE-NAVI"
            android:textColor="#08735C"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.12" />
        <TextView
            android:id="@+id/welcomeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Good evening, Citizen"
            android:textColor="#10231D"
            android:textSize="28sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Know what is ahead before you move."
            android:textColor="#647169"
            android:textSize="15sp" />
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="#092F28"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LOCATION SAFETY"
                            android:textColor="#C8F06F"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />
                        <TextView
                            android:id="@+id/riskLevelText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Moderate risk · High confidence"
                            android:textColor="#FFFFFF"
                            android:textSize="18sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="78dp"
                        android:layout_height="78dp"
                        android:background="@drawable/circle_green_background"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/safetyScoreText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="72"
                            android:textColor="#082C25"
                            android:textSize="28sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SAFE"
                            android:textColor="#19483E"
                            android:textSize="8sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/safetyExplanationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="A verified hazard nearby contributes to this score."
                    android:textColor="#C7D6D1"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/openSafetyMapButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="18dp"
                    android:text="Open safety map"
                    android:textAllCaps="false"
                    android:textColor="#10231D"
                    android:textStyle="bold"
                    app:backgroundTint="#C8F06F"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_map"
                    app:iconTint="#10231D" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Take action"
            android:textColor="#10231D"
            android:textSize="19sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reportDangerButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Report danger"
                android:textAllCaps="false"
                android:textColor="#B83A32"
                app:cornerRadius="16dp"
                app:strokeColor="#E8B4AF" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/openCommunityButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Local community"
                android:textAllCaps="false"
                android:textColor="#08735C"
                app:cornerRadius="16dp"
                app:strokeColor="#A8D6C9" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/openAssistantButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="Ask the Safe-Navi assistant"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            app:backgroundTint="#51645C"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_chatbot"
            app:iconTint="#FFFFFF" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/demoDisclosureButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="Synthetic demo data · Learn more"
            android:textAllCaps="false"
            android:textColor="#66756D" />
    </LinearLayout>
</ScrollView>
