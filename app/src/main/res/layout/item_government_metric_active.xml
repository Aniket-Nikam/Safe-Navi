<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:layout_marginHorizontal="5dp"
    android:background="#DDF2E9"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">
    <TextView android:id="@+id/activeCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" android:textColor="#08735C" android:textSize="25sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVE" android:textColor="#08735C" android:textSize="9sp" android:textStyle="bold" />
</LinearLayout>
