<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <org.maplibre.android.maps.MapView android:id="@+id/mapView" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView android:id="@+id/routeSearchCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="10dp" app:cardBackgroundColor="@color/surface_elevated" app:cardCornerRadius="20dp" app:cardElevation="4dp" app:strokeColor="@color/divider" app:strokeWidth="1dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
                <ImageButton android:id="@+id/backButton" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_arrow_forward" android:rotation="180" android:padding="12dp" android:contentDescription="Back" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/text_primary" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Where are you going?" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                <ImageButton android:id="@+id/locationButton" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_location" android:padding="12dp" android:contentDescription="Use my location" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/primary" />
                <ImageButton android:id="@+id/mapToolsButton" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_more" android:padding="12dp" android:contentDescription="Map tools" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/primary" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/bg_map_search_group">
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:hintEnabled="false" app:boxBackgroundMode="none" app:startIconDrawable="@drawable/ic_location" app:startIconTint="@color/primary">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/sourceInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:hint="A · Starting point" android:contentDescription="Starting point. Tap to search places" android:textSize="15sp" android:textColor="@color/text_primary" android:background="@android:color/transparent" android:paddingTop="12dp" android:paddingBottom="12dp" android:singleLine="true" android:focusable="false" android:clickable="true" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="48dp" android:layout_marginEnd="12dp" android:background="@color/divider" />
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/destinationInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" app:hintEnabled="false" app:boxBackgroundMode="none" app:startIconDrawable="@drawable/ic_pin" app:startIconTint="@color/signal_coral" app:endIconMode="custom" app:endIconDrawable="@drawable/ic_activity" app:endIconTint="@color/primary">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/destinationInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:hint="B · Search destination" android:contentDescription="Destination. Tap to search places" android:textSize="15sp" android:textColor="@color/text_primary" android:background="@android:color/transparent" android:paddingTop="12dp" android:paddingBottom="12dp" android:singleLine="true" android:focusable="false" android:clickable="true" android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton android:id="@+id/mapConnectionButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="10dp" android:layout_marginTop="6dp" android:maxWidth="150dp" android:text="Safety connection" android:textSize="11sp" android:letterSpacing="0" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/surface_elevated" app:cornerRadius="16dp" app:layout_constraintTop_toBottomOf="@id/routeSearchCard" app:layout_constraintStart_toStartOf="parent" />
    <com.google.android.material.card.MaterialCardView android:id="@+id/safetyScoreCard" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="10dp" android:layout_marginTop="6dp" app:cardBackgroundColor="@color/primary_dark" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:layout_constraintTop_toBottomOf="@id/routeSearchCard" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="10dp" android:gravity="center_vertical">
            <TextView android:id="@+id/mapSafetyScore" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/accent" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Area safety" android:textSize="10sp" android:textColor="@color/on_dark_surface" />
                <TextView android:id="@+id/mapSafetyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxWidth="115dp" android:maxLines="2" android:ellipsize="end" android:text="Checking…" android:textSize="11sp" android:textColor="@color/on_dark_surface" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton android:id="@+id/areaCrimeButton" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginStart="10dp" android:layout_marginBottom="6dp" android:text="Area reports" android:textSize="12sp" android:textAllCaps="false" android:letterSpacing="0" android:textColor="@color/text_primary" app:backgroundTint="@color/surface_elevated" app:cornerRadius="16dp" app:layout_constraintBottom_toTopOf="@id/routeControlCard" app:layout_constraintStart_toStartOf="parent" />
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/emergencyButton" android:layout_width="wrap_content" android:layout_height="44dp" android:layout_marginEnd="10dp" android:layout_marginBottom="6dp" android:text="SOS" android:textSize="13sp" android:textAllCaps="false" android:textColor="@color/on_danger" android:contentDescription="Open emergency toolkit" app:backgroundTint="@color/danger_text" app:cornerRadius="16dp" app:icon="@drawable/ic_warning" app:iconTint="@color/on_danger" app:layout_constraintBottom_toTopOf="@id/routeControlCard" app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView android:id="@+id/routeControlCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="10dp" app:cardBackgroundColor="@color/surface_elevated" app:cardCornerRadius="20dp" app:cardElevation="6dp" app:strokeColor="@color/divider" app:strokeWidth="1dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp">
            <TextView android:id="@+id/routeStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose your start and destination" android:textSize="12sp" android:textColor="@color/text_secondary" android:paddingBottom="6dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
                <TextView android:id="@+id/fastestRecommendation" style="@style/MapRouteOption" android:text="Fastest&#10;—" />
                <TextView android:id="@+id/balancedRecommendation" style="@style/MapRouteOption" android:text="Balanced&#10;—" android:layout_marginStart="6dp" android:layout_marginEnd="6dp" />
                <TextView android:id="@+id/safestRecommendation" style="@style/MapRouteOption" android:text="Safest&#10;—" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/travelModeButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="90dp" android:layout_height="48dp" android:text="@string/drive" android:textSize="12sp" android:letterSpacing="0" android:textAllCaps="false" app:cornerRadius="14dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/routeProfileButton" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/findRouteButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Compare routes" android:textSize="14sp" android:letterSpacing="0" android:textAllCaps="false" android:textStyle="bold" android:textColor="@color/on_accent" app:backgroundTint="@color/accent" app:cornerRadius="14dp" />
                <ProgressBar android:id="@+id/routeProgress" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginStart="8dp" android:visibility="gone" />
            </LinearLayout>
            <LinearLayout android:id="@+id/routeResultCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp" android:visibility="gone">
                <TextView android:id="@+id/routeResultTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/routeResultMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_secondary" />
                <TextView android:id="@+id/routeRiskSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:maxLines="3" android:textColor="@color/text_secondary" android:paddingTop="4dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/routeDetailsToggle" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="match_parent" android:layout_height="44dp" android:text="Why this route? · Details &amp; actions" android:textSize="12sp" android:letterSpacing="0" android:textAllCaps="false" />
                <LinearLayout android:id="@+id/routeDetailsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                    <TextView android:id="@+id/routeResultRisk" android:layout_width="match_parent" android:layout_height="wrap_content" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/shareRouteButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Share" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/openNavigationButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Navigate" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/saveDestinationButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Save place" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/startJourneyButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="Share journey" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView android:id="@+id/hazardDetailCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="10dp" android:visibility="gone" app:cardBackgroundColor="@color/surface_elevated" app:cardCornerRadius="18dp" app:cardElevation="8dp" app:layout_constraintBottom_toTopOf="@id/routeControlCard" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="14dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:id="@+id/hazardTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="16sp" android:textStyle="bold" android:textColor="@color/text_primary" />
                <ImageButton android:id="@+id/closeDetailButton" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_delete" android:contentDescription="Close details" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/text_secondary" />
            </LinearLayout>
            <TextView android:id="@+id/hazardMeta" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="@color/text_secondary" />
            <TextView android:id="@+id/hazardReason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="5" android:ellipsize="end" android:textSize="13sp" android:textColor="@color/text_primary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
