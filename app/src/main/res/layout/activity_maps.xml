<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
    <org.maplibre.android.maps.MapView android:id="@+id/mapView" android:layout_width="0dp" android:layout_height="0dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.card.MaterialCardView android:id="@+id/routeSearchCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="12dp" app:cardBackgroundColor="@color/surface_elevated" app:cardCornerRadius="24dp" app:cardElevation="3dp" app:strokeColor="@color/divider" app:strokeWidth="1dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical">
                <ImageButton android:id="@+id/backButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_arrow_forward" android:rotation="180" android:padding="14dp" android:contentDescription="Back" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/text_primary"/>
                <TextView android:id="@+id/mapSearchSummary" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" android:text="Where to?" android:textSize="15sp" android:textStyle="bold" android:textColor="@color/text_primary" android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground" android:contentDescription="Search destination"/>
                <ImageButton android:id="@+id/editEndpointsButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_activity" android:padding="14dp" android:contentDescription="Edit start and destination" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/primary"/>
                <ImageButton android:id="@+id/mapToolsButton" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_more" android:padding="14dp" android:contentDescription="Map tools and connection" android:background="?attr/selectableItemBackgroundBorderless" app:tint="@color/text_primary"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/endpointEditor" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="4dp" android:visibility="visible">
                <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:hintEnabled="false" app:boxBackgroundMode="none" app:startIconDrawable="@drawable/ic_location" app:startIconTint="@color/primary">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/sourceInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:hint="A · My location or starting point" android:textSize="14sp" android:textColor="@color/text_primary" android:background="@android:color/transparent" android:singleLine="true" android:focusable="false" android:clickable="true" android:inputType="none" android:paddingTop="12dp" android:paddingBottom="12dp"/>
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout android:id="@+id/destinationInputLayout" android:layout_width="match_parent" android:layout_height="wrap_content" app:hintEnabled="false" app:boxBackgroundMode="none" app:startIconDrawable="@drawable/ic_pin" app:startIconTint="@color/signal_coral" app:endIconMode="custom" app:endIconDrawable="@drawable/ic_activity">
                    <com.google.android.material.textfield.TextInputEditText android:id="@+id/destinationInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="50dp" android:hint="B · Destination" android:textSize="14sp" android:textColor="@color/text_primary" android:background="@android:color/transparent" android:singleLine="true" android:focusable="false" android:clickable="true" android:inputType="none" android:paddingTop="12dp" android:paddingBottom="12dp"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton android:id="@+id/riskLayerButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="12dp" android:layout_marginBottom="8dp" android:text="Route risks" android:textSize="12sp" android:letterSpacing="0" android:textAllCaps="false" android:textColor="@color/text_primary" app:backgroundTint="@color/surface_elevated" app:cornerRadius="24dp" app:layout_constraintBottom_toTopOf="@id/routeControlCard" app:layout_constraintStart_toStartOf="parent"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/emergencyButton" android:layout_width="76dp" android:layout_height="48dp" android:layout_marginEnd="12dp" android:layout_marginBottom="8dp" android:text="SOS" android:textSize="13sp" android:textAllCaps="false" android:letterSpacing="0" android:textColor="@color/on_danger" android:contentDescription="Open emergency toolkit" app:backgroundTint="@color/danger_text" app:cornerRadius="24dp" app:layout_constraintBottom_toTopOf="@id/routeControlCard" app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.card.MaterialCardView android:id="@+id/routeControlCard" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="12dp" app:cardBackgroundColor="@color/surface_elevated" app:cardCornerRadius="24dp" app:cardElevation="4dp" app:strokeColor="@color/divider" app:strokeWidth="1dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="8dp">
            <LinearLayout android:id="@+id/routeChoices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone">
<TextView android:id="@+id/fastestRecommendation" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_weight="1" android:layout_margin="3dp" android:padding="8dp" android:gravity="center" android:text="Fastest" android:textSize="12sp" android:textColor="@color/text_primary" android:clickable="true" android:focusable="true"/>
<TextView android:id="@+id/balancedRecommendation" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_weight="1" android:layout_margin="3dp" android:padding="8dp" android:gravity="center" android:text="Balanced" android:textSize="12sp" android:textColor="@color/text_primary" android:clickable="true" android:focusable="true"/>
<TextView android:id="@+id/safestRecommendation" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="58dp" android:layout_weight="1" android:layout_margin="3dp" android:padding="8dp" android:gravity="center" android:text="Safest" android:textSize="12sp" android:textColor="@color/text_primary" android:clickable="true" android:focusable="true"/>
            </LinearLayout>
            <TextView android:id="@+id/routeStatusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="8dp" android:paddingEnd="8dp" android:text="Choose a destination to begin" android:textSize="12sp" android:maxLines="2" android:textColor="@color/text_secondary"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="4dp" android:gravity="center_vertical">
                <com.google.android.material.button.MaterialButton android:id="@+id/travelModeButton" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="80dp" android:layout_height="48dp" android:text="@string/drive" android:textSize="12sp" android:letterSpacing="0" android:textAllCaps="false"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/findRouteButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Plan route" android:textSize="14sp" android:textAllCaps="false" android:letterSpacing="0" android:textStyle="bold" android:textColor="@color/on_accent" app:backgroundTint="@color/accent" app:cornerRadius="20dp"/>
                <ProgressBar android:id="@+id/routeProgress" android:layout_width="22dp" android:layout_height="22dp" android:layout_marginStart="8dp" android:visibility="gone"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton android:id="@+id/areaCrimeButton" android:layout_width="wrap_content" android:layout_height="48dp" android:layout_marginStart="12dp" android:layout_marginTop="6dp" android:text="Crime &amp; alerts" android:textSize="12sp" android:textAllCaps="false" android:letterSpacing="0" android:textColor="@color/text_primary" app:backgroundTint="@color/surface_elevated" app:cornerRadius="24dp" app:layout_constraintTop_toBottomOf="@id/routeSearchCard" app:layout_constraintStart_toStartOf="parent"/>

    <!-- Non-presentational state views preserve existing share/journey/role bindings.
         Their content is presented only in user-opened bottom sheets. -->
    <LinearLayout android:layout_width="0dp" android:layout_height="0dp" android:orientation="vertical" android:visibility="gone" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent">
        <ImageButton android:id="@+id/locationButton" android:layout_width="48dp" android:layout_height="48dp"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/mapConnectionButton" android:layout_width="wrap_content" android:layout_height="48dp"/>
        <LinearLayout android:id="@+id/safetyScoreCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/mapSafetyScore" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/mapSafetyLabel" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/routeProfileButton" android:layout_width="wrap_content" android:layout_height="48dp"/>
        <LinearLayout android:id="@+id/routeResultCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/routeResultTitle" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/routeResultMeta" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/routeRiskSummary" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/routeDetailsToggle" android:layout_width="match_parent" android:layout_height="48dp"/>
            <LinearLayout android:id="@+id/routeDetailsPanel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/routeResultRisk" android:layout_width="match_parent" android:layout_height="wrap_content"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/shareRouteButton" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/openNavigationButton" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/saveDestinationButton" android:layout_width="match_parent" android:layout_height="48dp"/>
                <com.google.android.material.button.MaterialButton android:id="@+id/startJourneyButton" android:layout_width="match_parent" android:layout_height="48dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/hazardDetailCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/hazardTitle" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <ImageButton android:id="@+id/closeDetailButton" android:layout_width="48dp" android:layout_height="48dp"/>
            <TextView android:id="@+id/hazardMeta" android:layout_width="match_parent" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/hazardReason" android:layout_width="match_parent" android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
