<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">
    <LinearLayout
        android:id="@+id/splashContentLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.0"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="36dp">
        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_safe_navi_mark" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Safe-Navi"
            android:textColor="#FFFFFF"
            android:textSize="36sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Routes that consider more than time."
            android:textColor="#CDE5DE"
            android:textSize="15sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_prototype_pill"
            android:letterSpacing="0.12"
            android:text="SYNTHETIC DATA PROTOTYPE"
            android:textColor="#D9F36A"
            android:textSize="10sp"
            android:textStyle="bold" />
        <ProgressBar
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginTop="24dp"
            android:indeterminateTint="#D9F36A" />
    </LinearLayout>
</FrameLayout>
